# ====================================================================
# MARVEL UNIVERSE - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Copia este archivo como .env y completa los valores correspondientes
# con los datos de tu consola de Firebase (https://console.firebase.google.com).
# NUNCA subas el archivo .env real con credenciales a repositorios públicos.

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Superhero REST API (Endpoint público, gratuito, sin API key)
VITE_SUPERHERO_API_URL="https://akabab.github.io/superhero-api/api"

# AI Studio runtime vars (opcionales)
GEMINI_API_KEY=""
APP_URL=""
