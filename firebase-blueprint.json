{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing basic authenticated user info",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "createdAt"
      ]
    },
    "FavoriteCharacter": {
      "title": "FavoriteCharacter",
      "description": "A favorite Marvel character saved by an authenticated user",
      "type": "object",
      "properties": {
        "characterId": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "maxLength": 150
        },
        "realName": {
          "type": "string",
          "maxLength": 150
        },
        "image": {
          "type": "string",
          "maxLength": 500
        },
        "publisher": {
          "type": "string",
          "maxLength": 50
        },
        "alignment": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "characterId",
        "name",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document matching auth.uid"
    },
    "/users/{userId}/favorites/{characterId}": {
      "schema": "FavoriteCharacter",
      "description": "Favorite superhero saved under user private favorites subcollection"
    }
  }
}
