rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User Profile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt', 'photoURL']) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 150 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Validation for Favorite Character
    function isValidFavorite(data) {
      return data.keys().hasAll(['characterId', 'name', 'createdAt']) &&
        data.keys().hasOnly(['characterId', 'name', 'realName', 'image', 'publisher', 'alignment', 'createdAt', 'powerstats']) &&
        (data.characterId is int || (data.characterId is string && data.characterId.size() <= 32)) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        (!('realName' in data) || (data.realName is string && data.realName.size() <= 150)) &&
        (!('image' in data) || (data.image is string && data.image.size() <= 500)) &&
        (!('publisher' in data) || (data.publisher is string && data.publisher.size() <= 50)) &&
        (!('alignment' in data) || (data.alignment is string && data.alignment.size() <= 30)) &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Deny broad enumeration of users

      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false; // Prevent client deletions of account data

      // Favorites Subcollection
      match /favorites/{characterId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(characterId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(characterId);
        allow update: if false; // Favorites are atomic creation and deletion
      }
    }
  }
}
